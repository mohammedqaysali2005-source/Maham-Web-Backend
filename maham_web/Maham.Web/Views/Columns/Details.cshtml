@model Maham.Web.Services.WebColumnDto
@{
    ViewData["Title"] = $"تفاصيل {Model.Name}";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h4 class="fw-bold text-primary mb-3 border-bottom pb-2"><i class="bi bi-layout-three-columns me-2 text-accent"></i>تفاصيل العمود</h4>
            <div class="detail-section p-0 shadow-none border-0">
                <div class="detail-row">
                    <div class="detail-label">الاسم</div>
                    <div class="detail-value fw-bold">@Model.Name</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">الترتيب</div>
                    <div class="detail-value">@Model.Order</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">الحد الأقصى WIP</div>
                    <div class="detail-value">@(Model.WipLimit.HasValue ? Model.WipLimit.Value.ToString() : "لا يوجد")</div>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <a href="/columns/@Model.Id/edit" class="btn btn-warning text-white"><i class="bi bi-pencil me-1"></i>تعديل</a>
                <a href="/columns/@Model.Id/delete" class="btn btn-danger"><i class="bi bi-trash me-1"></i>حذف</a>
                <a href="/boards/@Model.BoardId" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>عودة للوحة</a>
            </div>
        </div>
    </div>
</div>
