@model Maham.Application.DTOs.Column.CreateColumnDto
@{
    ViewData["Title"] = "إضافة عمود";
    var boardId = ViewBag.BoardId;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-layout-three-columns me-2 text-accent"></i>إضافة عمود جديد
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form action="/boards/@boardId/columns/create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">اسم العمود</label>
                    <input asp-for="Name" class="form-control" placeholder="مثال: قيد المراجعة" required maxlength="100" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="WipLimit" class="form-label">حد العمل الجاري (WIP Limit)</label>
                    <input asp-for="WipLimit" type="number" class="form-control" placeholder="اختياري" />
                    <span asp-validation-for="WipLimit" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> حفظ العمود</button>
                    <a href="/boards/@boardId" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
