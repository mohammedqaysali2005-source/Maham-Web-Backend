@model List<Maham.Web.Services.WebMemberDto>
@{
    ViewData["Title"] = "أعضاء المشروع";
    var projectId = ViewBag.ProjectId;
}

<div class="page-header pb-2 mb-3">
    <h2 class="page-title"><i class="bi bi-people text-accent me-2"></i>أعضاء المشروع</h2>
    <div class="d-flex gap-2">
        <a href="/projects/@projectId/members/add" class="btn btn-accent"><i class="bi bi-person-plus me-1"></i>إضافة عضو جديد</a>
        <a href="/projects/@projectId" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>عودة للمشروع</a>
    </div>
</div>

<div class="card shadow-sm p-4">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle dt-table w-100">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>الدور في المشروع</th>
                        <th>تاريخ الانضمام</th>
                        <th class="text-center">عمليات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in Model)
                    {
                        <tr>
                            <td class="fw-bold">@m.UserName</td>
                            <td>@m.UserEmail</td>
                            <td><span class="badge badge-role-@m.Role.ToLower()">@m.Role</span></td>
                            <td>@m.JoinedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a href="/projects/@projectId/members/@m.UserId" class="btn btn-primary" title="التفاصيل"><i class="bi bi-eye"></i></a>
                                    <a href="/projects/@projectId/members/@m.UserId/role" class="btn btn-warning text-white" title="تعديل الدور"><i class="bi bi-shield-lock"></i></a>
                                    <a href="/projects/@projectId/members/@m.UserId/remove" class="btn btn-danger" title="إزالة"><i class="bi bi-person-x"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state py-5 text-center">
            <i class="bi bi-people"></i>
            <h5>لا يوجد أعضاء في هذا المشروع</h5>
        </div>
    }
</div>
