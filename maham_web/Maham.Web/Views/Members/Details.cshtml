@model Maham.Web.Services.WebMemberDto
@{
    ViewData["Title"] = "تفاصيل العضو";
    var projectId = ViewBag.ProjectId;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm text-center">
            <i class="bi bi-person-badge text-primary display-2 mb-3"></i>
            <h4 class="fw-bold text-primary mb-3">@Model.UserName</h4>
            
            <div class="detail-section p-0 shadow-none border-0 text-start">
                <div class="detail-row">
                    <div class="detail-label">الاسم</div>
                    <div class="detail-value fw-bold">@Model.UserName</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">البريد الإلكتروني</div>
                    <div class="detail-value">@Model.UserEmail</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">الدور في المشروع</div>
                    <div class="detail-value"><span class="badge badge-role-@Model.Role.ToLower()">@Model.Role</span></div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">تاريخ الانضمام</div>
                    <div class="detail-value">@Model.JoinedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
            
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/projects/@projectId/members/@Model.UserId/role" class="btn btn-warning text-white px-4"><i class="bi bi-shield-lock me-1"></i>تعديل الدور</a>
                <a href="/projects/@projectId/members/@Model.UserId/remove" class="btn btn-danger px-4"><i class="bi bi-person-x me-1"></i>إزالة من المشروع</a>
                <a href="/projects/@projectId/members" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-right me-1"></i>عودة للأعضاء</a>
            </div>
        </div>
    </div>
</div>
