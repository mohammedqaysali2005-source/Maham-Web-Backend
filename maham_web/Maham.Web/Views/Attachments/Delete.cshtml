@model Maham.Web.Services.WebAttachmentDto
@{
    ViewData["Title"] = "حذف المرفق";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card p-4 shadow border border-danger text-center">
            <i class="bi bi-trash text-danger display-1 mb-3 d-block"></i>
            <h3 class="fw-bold text-danger">تأكيد حذف الملف المرفق</h3>
            <p class="fs-5 text-muted mt-2">
                هل أنت متأكد من حذف الملف المرفق <strong class="text-dark">"@Model.FileName"</strong>؟
            </p>

            <form id="delete-form" action="/attachments/@Model.Id/delete" method="post">
                <div class="d-flex justify-content-center gap-3 mt-4">
                    <button type="submit" class="btn btn-danger px-4 py-2"><i class="bi bi-trash me-1"></i>نعم، احذف الملف</button>
                    <a href="/cards/@Model.CardId" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
