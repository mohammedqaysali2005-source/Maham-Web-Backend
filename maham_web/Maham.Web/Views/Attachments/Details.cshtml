@model Maham.Web.Services.WebAttachmentDto
@{
    ViewData["Title"] = "تفاصيل المرفق";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm text-center">
            <i class="bi bi-file-earmark-arrow-down text-primary display-2 mb-3"></i>
            <h4 class="fw-bold text-primary mb-3">@Model.FileName</h4>
            
            <div class="detail-section p-0 shadow-none border-0 text-start">
                <div class="detail-row">
                    <div class="detail-label">الاسم</div>
                    <div class="detail-value fw-bold">@Model.FileName</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">الحجم</div>
                    <div class="detail-value">@((Model.FileSize / 1024.0).ToString("F1")) KB</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">النوع (Mime)</div>
                    <div class="detail-value text-secondary">@Model.MimeType</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">رفع بواسطة</div>
                    <div class="detail-value">@Model.UploadedByName</div>
                </div>
                <div class="detail-row">
                    <div class="detail-label">تاريخ الرفع</div>
                    <div class="detail-value">@Model.UploadedAt.ToString("yyyy-MM-dd HH:mm")</div>
                </div>
            </div>
            
            <div class="d-flex justify-content-center gap-2 mt-4">
                <a href="/attachments/@Model.Id/download" class="btn btn-success text-white px-4"><i class="bi bi-download me-1"></i>تحميل الملف</a>
                <a href="/attachments/@Model.Id/delete" class="btn btn-danger px-4"><i class="bi bi-trash me-1"></i>حذف المرفق</a>
                <a href="/cards/@Model.CardId" class="btn btn-outline-secondary px-4"><i class="bi bi-arrow-right me-1"></i>عودة للبطاقة</a>
            </div>
        </div>
    </div>
</div>
