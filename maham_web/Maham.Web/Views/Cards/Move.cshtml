@{
    ViewData["Title"] = "نقل البطاقة";
    var card = ViewBag.Card as Maham.Web.Services.WebCardDto ?? new();
    var columns = ViewBag.Columns as List<Maham.Web.Services.WebColumnDto> ?? new();
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-arrow-left-right me-2 text-accent"></i>نقل البطاقة
            </h3>

            <p class="text-muted mb-4">اختر العمود الوجهة لنقل البطاقة <strong>"@card.Title"</strong> إليه.</p>

            <form action="/cards/@card.Id/move" method="post">
                <div class="mb-4">
                    <label class="form-label">العمود الوجهة</label>
                    <select name="toColumnId" class="form-select" required>
                        @foreach (var col in columns)
                        {
                            <option value="@col.Id" selected="@(col.Id == card.ColumnId)">@col.Name</option>
                        }
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-check-circle me-1"></i> نقل البطاقة</button>
                    <a href="/cards/@card.Id" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
