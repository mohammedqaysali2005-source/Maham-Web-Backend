@model Maham.Web.Services.WebCardDto
@{
    ViewData["Title"] = $"بطاقة: {Model.Title}";
    var comments = ViewBag.Comments as List<Maham.Web.Services.WebCommentDto> ?? new();
    var attachments = ViewBag.Attachments as List<Maham.Web.Services.WebAttachmentDto> ?? new();
    var activity = ViewBag.Activity as List<Maham.Web.Services.WebActivityDto> ?? new();
    var columns = ViewBag.Columns as List<Maham.Web.Services.WebColumnDto> ?? new();
    var members = ViewBag.Members as List<Maham.Web.Services.WebMemberDto> ?? new();
}

<div class="page-header pb-2 mb-3">
    <h2 class="page-title"><i class="bi bi-card-heading text-accent me-2"></i>@Model.Title</h2>
    <div class="d-flex gap-2">
        <a href="/cards/@Model.Id/edit" class="btn btn-warning text-white"><i class="bi bi-pencil me-1"></i>تعديل</a>
        <a href="/cards/@Model.Id/move" class="btn btn-primary"><i class="bi bi-arrow-left-right me-1"></i>نقل</a>
        <a href="/cards/@Model.Id/delete" class="btn btn-danger"><i class="bi bi-trash me-1"></i>حذف</a>
        <a href="javascript:history.back()" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>رجوع</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.CoverImageUrl))
{
    <div class="mb-4">
        <img src="@Model.CoverImageUrl" class="rounded shadow-sm" style="width: 100%; height: 250px; object-fit: cover;" alt="Cover" />
    </div>
}

<div class="row g-4">
    <!-- Right side: Details, comments, attachments -->
    <div class="col-lg-8">
        <div class="detail-section">
            <h5>تفاصيل البطاقة</h5>
            <div class="detail-row">
                <div class="detail-label">العنوان</div>
                <div class="detail-value fw-bold">@Model.Title</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">الوصف</div>
                <div class="detail-value">@(Model.Description ?? "لا يوجد وصف لهذه البطاقة")</div>
            </div>
            <div class="detail-row">
                <div class="detail-label">تاريخ الإنشاء</div>
                <div class="detail-value">@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="card p-4 shadow-sm mb-4">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="bi bi-chat-left-text me-2"></i>التعليقات (@comments.Count)
            </h5>
            
            <form action="/cards/@Model.Id/comments/create" method="post" class="mb-4">
                <div class="mb-3">
                    <textarea name="Content" class="form-control" rows="3" placeholder="أدخل تعليقك هنا..." required></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-sm"><i class="bi bi-send me-1"></i>إرسال التعليق</button>
            </form>

            @if (comments.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var comment in comments)
                    {
                        <div class="list-group-item p-3 mb-2 border rounded shadow-xs bg-light">
                            <div class="d-flex w-100 justify-content-between align-items-center mb-1">
                                <span class="fw-bold text-primary">@comment.AuthorName</span>
                                <small class="text-muted">@comment.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                            </div>
                            <p class="mb-0 small text-dark">@comment.Content</p>
                            <div class="mt-2 text-start">
                                <a href="/comments/@comment.Id/edit" class="btn btn-xs text-warning p-0 me-2"><i class="bi bi-pencil"></i> تعديل</a>
                                <a href="/comments/@comment.Id/delete" class="btn btn-xs text-danger p-0"><i class="bi bi-trash"></i> حذف</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3">لا توجد تعليقات بعد.</p>
            }
        </div>

        <!-- Attachments Section -->
        <div class="card p-4 shadow-sm">
            <h5 class="fw-bold text-primary mb-3 border-bottom pb-2">
                <i class="bi bi-paperclip me-2 text-accent"></i>الملفات المرفقة (@attachments.Count)
            </h5>

            <form action="/cards/@Model.Id/attachments/create" method="post" enctype="multipart/form-data" class="mb-4">
                <div class="input-group input-group-sm">
                    <input type="file" name="file" class="form-control" required />
                    <button class="btn btn-accent" type="submit"><i class="bi bi-upload me-1"></i>رفع الملف</button>
                </div>
            </form>

            @if (attachments.Any())
            {
                <div class="row g-3">
                    @foreach (var att in attachments)
                    {
                        <div class="col-md-6">
                            <div class="p-3 border rounded shadow-xs bg-white d-flex align-items-center justify-content-between">
                                <div>
                                    <strong class="d-block text-truncate" style="max-width: 180px;">@att.FileName</strong>
                                    <small class="text-muted">@((att.FileSize / 1024.0).ToString("F1")) KB</small>
                                </div>
                                <div class="d-flex gap-1">
                                    <a href="/attachments/@att.Id/download" class="btn btn-sm btn-outline-primary" title="تحميل"><i class="bi bi-download"></i></a>
                                    <a href="/attachments/@att.Id/delete" class="btn btn-sm btn-outline-danger" title="حذف"><i class="bi bi-trash"></i></a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted text-center py-3">لا توجد ملفات مرفقة.</p>
            }
        </div>
    </div>

    <!-- Left side: fast updates and activity log -->
    <div class="col-lg-4">
        <!-- Quick Settings -->
        <div class="card p-4 shadow-sm mb-4">
            <h5 class="fw-bold mb-3 text-primary border-bottom pb-2">الإعدادات السريعة</h5>
            
            <!-- Assignee Form -->
            <form action="/cards/@Model.Id/assign" method="post" class="mb-3">
                <label class="form-label">المسؤول عن المهمة</label>
                <div class="input-group">
                    <select name="assigneeId" class="form-select form-select-sm">
                        <option value="">غير معين</option>
                        @foreach (var mem in members)
                        {
                            <option value="@mem.UserId" selected="@(mem.UserId == Model.AssigneeId)">@mem.UserName</option>
                        }
                    </select>
                    <button class="btn btn-sm btn-primary" type="submit">تعيين</button>
                </div>
            </form>

            <!-- Priority Form -->
            <form action="/cards/@Model.Id/priority" method="post" class="mb-3">
                <label class="form-label">الأولوية</label>
                <div class="input-group">
                    <select name="priority" class="form-select form-select-sm">
                        <option value="Low" selected="@(Model.Priority == "Low")">Low</option>
                        <option value="Medium" selected="@(Model.Priority == "Medium")">Medium</option>
                        <option value="High" selected="@(Model.Priority == "High")">High</option>
                        <option value="Critical" selected="@(Model.Priority == "Critical")">Critical</option>
                    </select>
                    <button class="btn btn-sm btn-primary" type="submit">حفظ</button>
                </div>
            </form>

            <!-- Status Form -->
            <form action="/cards/@Model.Id/status" method="post" class="mb-3">
                <label class="form-label">الحالة</label>
                <div class="input-group">
                    <select name="status" class="form-select form-select-sm">
                        <option value="Todo" selected="@(Model.Status == "Todo")">Todo</option>
                        <option value="InProgress" selected="@(Model.Status == "InProgress")">InProgress</option>
                        <option value="Done" selected="@(Model.Status == "Done")">Done</option>
                    </select>
                    <button class="btn btn-sm btn-primary" type="submit">حفظ</button>
                </div>
            </form>

            <!-- Labels Form -->
            <form action="/cards/@Model.Id/labels" method="post" class="mb-3">
                <label class="form-label">التسميات (Labels)</label>
                <div class="input-group">
                    <input type="text" name="labels" value="@Model.Labels" class="form-control form-control-sm" placeholder="Bug, Feature, Dev" />
                    <button class="btn btn-sm btn-primary" type="submit">حفظ</button>
                </div>
            </form>

            <!-- Cover Image Form -->
            <div class="mt-3">
                <a href="/cards/@Model.Id/cover" class="btn btn-sm btn-outline-accent w-100"><i class="bi bi-image me-1"></i>تغيير غلاف البطاقة</a>
            </div>
        </div>

        <!-- Activity Timeline -->
        <div class="card p-4 shadow-sm">
            <h5 class="fw-bold text-warning mb-3 border-bottom pb-2">سجل نشاط البطاقة</h5>
            <div class="activity-timeline">
                @if (activity.Any())
                {
                    @foreach (var act in activity)
                    {
                        <div class="activity-item py-2">
                            <div class="activity-content">
                                <span class="fw-semibold small">@act.UserName</span> <span class="small text-dark">@act.Action</span>
                                <div class="text-muted small" style="font-size: 0.72rem;">@act.CreatedAt.ToString("MM-dd HH:mm")</div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted small">لا توجد أنشطة مسجلة</p>
                }
            </div>
        </div>
    </div>
</div>
