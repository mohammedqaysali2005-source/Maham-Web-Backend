@model Maham.Web.Services.WebCardDto
@{
    ViewData["Title"] = "حذف البطاقة";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card p-4 shadow border border-danger text-center">
            <i class="bi bi-exclamation-triangle text-danger display-1 mb-3 d-block"></i>
            <h3 class="fw-bold text-danger">تأكيد حذف البطاقة</h3>
            <p class="fs-5 text-muted mt-2">
                هل أنت متأكد من حذف المهمة <strong class="text-dark">"@Model.Title"</strong>؟
            </p>
            <div class="alert alert-danger m-3 text-start">
                <i class="bi bi-exclamation-octagon-fill me-2"></i><strong>تنبيه:</strong> سيؤدي حذف البطاقة إلى حذف جميع التعليقات والمرفقات الخاصة بها نهائياً وبدون إمكانية للاسترجاع.
            </div>

            <form id="delete-form" action="/cards/@Model.Id/delete" method="post">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-danger px-4 py-2"><i class="bi bi-trash me-1"></i>نعم، احذف البطاقة</button>
                    <a href="/cards/@Model.Id" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
