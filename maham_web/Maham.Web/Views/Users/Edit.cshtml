@model Maham.Application.DTOs.Auth.UpdateProfileDto
@{
    ViewData["Title"] = "تعديل المستخدم";
    var userId = ViewBag.UserId;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm border-0 rounded-4">
            <h3 class="fw-bold text-warning mb-4 border-bottom pb-2">
                <i class="bi bi-pencil-square me-2 text-primary"></i>تعديل بيانات المستخدم
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form action="/users/@userId/edit" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">الاسم الكامل</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="FullName" type="text" class="form-control" required />
                    </div>
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AvatarUrl" class="form-label fw-semibold">رابط الصورة الشخصية (Avatar URL)</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-image"></i></span>
                        <input asp-for="AvatarUrl" type="url" class="form-control" placeholder="https://example.com/avatar.jpg" />
                    </div>
                    <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-warning text-white px-4 py-2 fw-bold">
                        <i class="bi bi-save me-1"></i> حفظ التغيرات
                    </button>
                    <a href="/users/@userId" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
