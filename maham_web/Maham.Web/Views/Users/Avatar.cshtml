@{
    ViewData["Title"] = "تحديث الصورة الشخصية";
    var userId = ViewBag.UserId;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-image me-2 text-accent"></i>تحديث الصورة الشخصية
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form action="/users/@userId/avatar" method="post" enctype="multipart/form-data">
                <div class="mb-4">
                    <label class="form-label fw-bold">اختر صورتك الشخصية</label>
                    <input type="file" name="file" class="form-control" accept="image/*" required />
                    <div class="form-text">الصيغ المدعومة: JPG, PNG, GIF. الحجم الأقصى: 5MB</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-cloud-upload me-1"></i> رفع الصورة</button>
                    <a href="/users/@userId" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
