@model Maham.Web.Services.WebUserDto
@{
    ViewData["Title"] = "حذف المستخدم";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card p-4 shadow border border-danger text-center">
            <i class="bi bi-person-x-fill text-danger display-1 mb-3 d-block"></i>
            <h3 class="fw-bold text-danger">تأكيد حذف المستخدم</h3>
            <p class="fs-5 text-muted mt-2">
                هل أنت متأكد من حذف حساب <strong class="text-dark">@Model.FullName</strong>؟
            </p>
            <div class="alert alert-danger m-3 text-start">
                <i class="bi bi-exclamation-octagon-fill me-2"></i><strong>تحذير:</strong> هذا الإجراء سيحذف حساب المستخدم وكافة بياناته نهائياً وبشكل لا رجعة فيه.
            </div>

            <form action="/users/@Model.Id/delete" method="post">
                <div class="d-flex justify-content-center gap-3">
                    <button type="submit" class="btn btn-danger px-4 py-2"><i class="bi bi-trash me-1"></i>نعم، احذف الحساب</button>
                    <a href="/users/@Model.Id" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
