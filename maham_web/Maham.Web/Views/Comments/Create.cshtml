@model Maham.Application.DTOs.Comment.CreateCommentDto
@{
    ViewData["Title"] = "إضافة تعليق";
    var cardId = ViewBag.CardId;
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-chat-left-text me-2 text-accent"></i>إضافة تعليق جديد
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form action="/cards/@cardId/comments/create" method="post">
                <div class="mb-4">
                    <label asp-for="Content" class="form-label">محتوى التعليق</label>
                    <textarea asp-for="Content" class="form-control" rows="4" placeholder="أكتب تعليقك هنا..." required></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-send me-1"></i> نشر التعليق</button>
                    <a href="/cards/@cardId" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
