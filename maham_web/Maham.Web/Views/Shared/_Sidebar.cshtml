<aside class="sidebar">
    <div class="sidebar-section">الرئيسية والمتابعة</div>
    <ul class="sidebar-nav">
        <li>
            <a href="/dashboard" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i>
                <span>لوحة المعلومات</span>
            </a>
        </li>
        <li>
            <a href="/cards/my" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cards" && ViewContext.RouteData.Values["action"]?.ToString() == "My" ? "active" : "")">
                <i class="bi bi-check2-circle"></i>
                <span>مهامي الموكلة</span>
            </a>
        </li>
        <li>
            <a href="/activity" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Activity" ? "active" : "")">
                <i class="bi bi-lightning-charge-fill"></i>
                <span>سجل النشاطات</span>
            </a>
        </li>
        <li>
            <a href="/projects/invitations" class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Invitations" ? "active" : "")">
                <i class="bi bi-bell-fill text-warning"></i>
                <span>دعوات الانضمام</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section">إدارة العمل والمشاريع</div>
    <ul class="sidebar-nav">
        <li>
            <a href="/projects" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Projects" ? "active" : "")">
                <i class="bi bi-folder-fill"></i>
                <span>كافة المشاريع</span>
            </a>
        </li>
        <li>
            <a href="/cards" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Cards" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="bi bi-kanban-fill"></i>
                <span>بطاقات الكانبان</span>
            </a>
        </li>
    </ul>

    <div class="sidebar-section">النظام والإدارة</div>
    <ul class="sidebar-nav">
        @if (Maham.Web.Helpers.SessionHelper.IsAdmin(Context.Session))
        {
            <li>
                <a href="/admin/dashboard" class="text-danger fw-bold">
                    <i class="bi bi-shield-lock-fill text-danger"></i>
                    <span>منطقة الإدارة (Admin)</span>
                </a>
            </li>
        }
        <li>
            <a href="/users" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")">
                <i class="bi bi-people-fill"></i>
                <span>أعضاء المنصة</span>
            </a>
        </li>
        <li class="mt-3 pt-2 border-top border-white border-opacity-10">
            <a href="/auth/logout" class="text-danger">
                <i class="bi bi-box-arrow-right text-danger"></i>
                <span>تسجيل الخروج</span>
            </a>
        </li>
    </ul>
</aside>
