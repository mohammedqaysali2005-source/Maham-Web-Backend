@using Maham.Web.Helpers
@model List<Maham.Web.Services.WebProjectInvitationDto>
@{
    ViewData["Title"] = "دعوات الانضمام للمشاريع";
}

<div class="page-header pb-2 mb-3">
    <h2 class="page-title"><i class="bi bi-bell text-accent me-2"></i>دعوات الانضمام للمشاريع والإشعارات</h2>
    <span class="text-muted">قم بقبول الدعوة للانضمام إلى المشروع والبدء في متابعة لوحات الكانبان والمهام</span>
</div>

@if (Model.Any())
{
    <div class="row g-3">
        @foreach (var inv in Model)
        {
            <div class="col-md-6">
                <div class="card p-4 shadow-sm border-start border-accent border-4 h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold text-primary mb-1">@inv.ProjectName</h5>
                            <span class="badge badge-role-member">@TranslationHelper.ToArabicRole(inv.Role)</span>
                        </div>
                        <p class="text-secondary small mb-3">
                            @(inv.ProjectDescription ?? "لا يوجد وصف لهذا المشروع")
                        </p>
                        <div class="bg-light p-2 rounded mb-3 text-secondary small">
                            <i class="bi bi-person-circle me-1 text-primary"></i>دعوة مقدمة من: <strong>@inv.InviterName</strong>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3 text-muted small">
                            <span><i class="bi bi-clock me-1"></i>تاريخ الدعوة: @inv.InvitedAt.ToString("yyyy-MM-dd HH:mm")</span>
                        </div>
                        <div class="d-flex gap-2">
                            <form action="/projects/invitations/@inv.MemberId/accept" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-success w-100 fw-bold">
                                    <i class="bi bi-check-circle me-1"></i>قبول الدعوة
                                </button>
                            </form>
                            <form action="/projects/invitations/@inv.MemberId/reject" method="post" class="flex-grow-1">
                                <button type="submit" class="btn btn-outline-danger w-100 fw-bold">
                                    <i class="bi bi-x-circle me-1"></i>رفض
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 border-0 shadow-sm rounded-4 text-center">
        <div class="empty-state py-5">
            <i class="bi bi-bell-slash display-3 text-muted d-block mb-3"></i>
            <h5 class="fw-bold text-primary mb-2">لا توجد دعوات معلقة حالياً</h5>
            <p class="text-muted mb-0">عندما يقوم أي مدير بدعوتك للانضمام إلى مشروعه، ستظهر الدعوة هنا فوراً لتتمكن من قبولها.</p>
        </div>
    </div>
}
