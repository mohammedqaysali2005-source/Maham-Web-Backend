@model Maham.Application.DTOs.Project.CreateProjectDto
@{
    ViewData["Title"] = "مشروع جديد";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-folder-plus me-2 text-accent"></i>إنشاء مشروع جديد
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Create" method="post">
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">اسم المشروع</label>
                    <input asp-for="Name" class="form-control" placeholder="أدخل اسم المشروع" required maxlength="100" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label">وصف المشروع</label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف موجز للمشروع وأهدافه..."></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> حفظ المشروع</button>
                    <a href="/projects" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
