@model Maham.Application.DTOs.Auth.UpdateProfileDto
@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6">
        <div class="card p-4 shadow-sm">
            <h3 class="fw-bold text-primary mb-4 border-bottom pb-2">
                <i class="bi bi-person-circle me-2 text-accent"></i>تعديل الملف الشخصي
            </h3>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2"></i> @ViewBag.Error
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Profile" method="post">
                <div class="mb-3">
                    <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                    <input asp-for="FullName" class="form-control" required />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="AvatarUrl" class="form-label">رابط الصورة الشخصية (Avatar URL)</label>
                    <input asp-for="AvatarUrl" class="form-control" placeholder="http://example.com/image.png" />
                    <span asp-validation-for="AvatarUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> حفظ التغييرات</button>
                    <a href="/dashboard" class="btn btn-outline-secondary px-4 py-2">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>
