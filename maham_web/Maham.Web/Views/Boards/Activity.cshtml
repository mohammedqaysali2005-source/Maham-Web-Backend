@model List<Maham.Web.Services.WebActivityDto>
@{
    ViewData["Title"] = "نشاط اللوحة";
    var boardId = ViewBag.BoardId;
}

<div class="page-header pb-2 mb-3">
    <h2 class="page-title"><i class="bi bi-clock-history me-2 text-warning"></i>سجل نشاط اللوحة</h2>
    <a href="/boards/@boardId" class="btn btn-outline-secondary"><i class="bi bi-arrow-right me-1"></i>عودة للوحة</a>
</div>

<div class="card shadow-sm p-4">
    @if (Model.Any())
    {
        <div class="activity-timeline">
            @foreach (var act in Model)
            {
                <div class="activity-item">
                    <div class="activity-icon">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div class="activity-content">
                        <div class="activity-action text-dark">
                            <strong>@act.UserName</strong> @act.Action
                        </div>
                        <div class="text-muted small">@act.Description</div>
                        <div class="activity-time mt-1 text-secondary">
                            <i class="bi bi-clock-history me-1"></i>@act.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state py-5 text-center">
            <i class="bi bi-clipboard-x display-4 d-block mb-3"></i>
            <h6 class="text-muted">لا يوجد سجل نشاط مسجل للوحة</h6>
        </div>
    }
</div>
