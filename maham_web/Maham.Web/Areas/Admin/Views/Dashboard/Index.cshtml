@{
    ViewData["Title"] = "مركز التحكم والعرض التنفيذي (Admin Demo Center)";
    var stats = ViewBag.Stats as Maham.Web.Services.WebDashboardDto ?? new Maham.Web.Services.WebDashboardDto();
    var usersCount = ViewBag.UsersCount ?? 0;
    var projectsCount = ViewBag.ProjectsCount ?? 0;
    var recentUsers = ViewBag.RecentUsers as List<Maham.Web.Services.WebUserDto> ?? new();
    var recentProjects = ViewBag.RecentProjects as List<Maham.Web.Services.WebProjectDto> ?? new();
}

<!-- Executive Header -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-shield-lock-fill text-danger me-2"></i>مركز التحكم والعرض التنفيذي (Admin Demo Center)
        </h2>
        <span class="text-muted fs-6">جاهز بالكامل للعرض المباشر أمام الشركات والمقيمين التقنيين</span>
    </div>
    <div class="d-flex align-items-center gap-2">
        <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 py-2 rounded-pill fs-7 fw-bold">
            <i class="bi bi-broadcast me-1"></i>النظام يعمل في وضع الإنتاج 100%
        </span>
        <a href="/dashboard" class="btn btn-primary btn-sm py-2 px-3 shadow-sm rounded-3">
            <i class="bi bi-speedometer2 me-1"></i>لوحة المعلومات للمستخدم
        </a>
    </div>
</div>

<!-- System Health & Live Architecture Status Bar -->
<div class="card p-3 mb-4 border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 100%); color: white;">
    <div class="row g-3 align-items-center">
        <div class="col-md-3 border-end border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-success bg-opacity-25 text-success"><i class="bi bi-database-fill-check fs-5"></i></span>
                <div>
                    <div class="small text-white-50">قاعدة البيانات (PostgreSQL)</div>
                    <div class="fw-bold text-white small"><span class="badge bg-success p-1 me-1">متصلة</span> Port 5432</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 border-end border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-info bg-opacity-25 text-info"><i class="bi bi-cpu-fill fs-5"></i></span>
                <div>
                    <div class="small text-white-50">خادم الـ API (ASP.NET Core 6)</div>
                    <div class="fw-bold text-white small"><span class="badge bg-info p-1 me-1">نشط</span> 0.0.0.0:5233</div>
                </div>
            </div>
        </div>
        <div class="col-md-3 border-end border-white border-opacity-10">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-warning bg-opacity-25 text-warning"><i class="bi bi-broadcast-pin fs-5"></i></span>
                <div>
                    <div class="small text-white-50">التزامن اللحظي (SignalR)</div>
                    <div class="fw-bold text-white small"><span class="badge bg-warning text-dark p-1 me-1">WebSockets</span> BoardHub</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="d-flex align-items-center gap-2">
                <span class="p-2 rounded-3 bg-purple bg-opacity-25" style="color: #A855F7; background: rgba(168,85,247,0.2);"><i class="bi bi-layers-fill fs-5"></i></span>
                <div>
                    <div class="small text-white-50">المعمارية الهندسية</div>
                    <div class="fw-bold text-white small">Clean Architecture 4Tiers</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Metrics Row -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-info">
                <div class="stat-num text-primary">@usersCount</div>
                <div class="stat-label">المستخدمين المعتمدين</div>
            </div>
            <div class="stat-icon-wrapper stat-icon-projects">
                <i class="bi bi-people-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-info">
                <div class="stat-num text-success">@projectsCount</div>
                <div class="stat-label">المشاريع المؤسسية</div>
            </div>
            <div class="stat-icon-wrapper stat-icon-boards">
                <i class="bi bi-folder-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-info">
                <div class="stat-num text-warning">@stats.InProgressCards</div>
                <div class="stat-label">مهام قيد العمل الآن</div>
            </div>
            <div class="stat-icon-wrapper stat-icon-members">
                <i class="bi bi-kanban-fill"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <div class="stat-info">
                <div class="stat-num text-danger">@stats.TotalCards</div>
                <div class="stat-label">إجمالي بطاقات النظام</div>
            </div>
            <div class="stat-icon-wrapper stat-icon-overdue">
                <i class="bi bi-card-checklist"></i>
            </div>
        </div>
    </div>
</div>

<!-- Ready-made Showcase Projects for Instant Demo -->
<div class="card p-4 border-0 shadow-sm rounded-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <h5 class="fw-bold text-dark mb-1">
                <i class="bi bi-rocket-takeoff-fill text-danger me-2"></i>المشاريع الجاهزة للعرض المباشر (One-Click Showcase Projects)
            </h5>
            <span class="text-muted small">يمكنك النقر مباشرة على أي مشروع لعرضه بكل تفاصيله وبطاقاته التفاعلية</span>
        </div>
        <a href="/projects" class="btn btn-sm btn-outline-primary fw-bold">استعراض كافة المشاريع</a>
    </div>

    <div class="row g-3">
        <!-- Project 1: Maham Web -->
        <div class="col-md-6 col-lg-3">
            <div class="card p-3 h-100 border border-primary border-opacity-25 shadow-xs bg-white rounded-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-primary p-2"><i class="bi bi-laptop fs-6"></i></span>
                    <h6 class="fw-bold m-0 text-dark text-truncate">منصة مهام للويب (ASP.NET Core)</h6>
                </div>
                <p class="text-muted small mb-3">نظام الكانبان التفاعلي، المعمارية النظيفة، ومزامنة SignalR اللحظية.</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="/boards/b1111111-1111-1111-1111-111111111111" class="btn btn-sm btn-primary w-100 fw-bold">
                        <i class="bi bi-kanban me-1"></i>لوحة الكانبان
                    </a>
                    <a href="/projects/a1111111-1111-1111-1111-111111111111" class="btn btn-sm btn-outline-secondary" title="التفاصيل">
                        <i class="bi bi-eye"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 2: Flutter Mobile -->
        <div class="col-md-6 col-lg-3">
            <div class="card p-3 h-100 border border-info border-opacity-25 shadow-xs bg-white rounded-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-info p-2 text-white"><i class="bi bi-phone-fill fs-6"></i></span>
                    <h6 class="fw-bold m-0 text-dark text-truncate">تطبيق الموبايل (Flutter BLoC)</h6>
                </div>
                <p class="text-muted small mb-3">تطبيق فلاتر يدعم اللغة العربية RTL وإدارة الحالة بنمط BLoC وتكامل الـ API.</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="/projects/a2222222-2222-2222-2222-222222222222" class="btn btn-sm btn-info text-white w-100 fw-bold">
                        <i class="bi bi-folder me-1"></i>فتح المشروع
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 3: AI Assistant -->
        <div class="col-md-6 col-lg-3">
            <div class="card p-3 h-100 border border-warning border-opacity-25 shadow-xs bg-white rounded-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-warning text-dark p-2"><i class="bi bi-robot fs-6"></i></span>
                    <h6 class="fw-bold m-0 text-dark text-truncate">نظام الذكاء الاصطناعي (AI Task)</h6>
                </div>
                <p class="text-muted small mb-3">توليد وتفكيك المهام اليومية وتقدير نقاط القصة باستخدام الذكاء الاصطناعي.</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="/projects/a3333333-3333-3333-3333-333333333333" class="btn btn-sm btn-warning text-dark w-100 fw-bold">
                        <i class="bi bi-folder me-1"></i>فتح المشروع
                    </a>
                </div>
            </div>
        </div>

        <!-- Project 4: DevOps & Security -->
        <div class="col-md-6 col-lg-3">
            <div class="card p-3 h-100 border border-success border-opacity-25 shadow-xs bg-white rounded-3">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="badge bg-success p-2"><i class="bi bi-shield-check fs-6"></i></span>
                    <h6 class="fw-bold m-0 text-dark text-truncate">البنية التحتية (DevOps Docker)</h6>
                </div>
                <p class="text-muted small mb-3">حاويات Docker، توثيق وتشفير JWT، وإعداد بيئة التشغيل السحابية المستمرة.</p>
                <div class="mt-auto d-flex gap-2">
                    <a href="/projects/a4444444-4444-4444-4444-444444444444" class="btn btn-sm btn-success w-100 fw-bold">
                        <i class="bi bi-folder me-1"></i>فتح المشروع
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Details Tables Row: Users and Activity -->
<div class="row g-4">
    <!-- Users Matrix -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill me-2 text-primary"></i>فريق العمل المعتمد في العرض</h5>
                <a href="/admin/users" class="btn btn-sm btn-outline-primary fw-bold">إدارة الصلاحيات</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>العضو</th>
                            <th>البريد</th>
                            <th>الدور</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var u in recentUsers)
                        {
                            var initial = !string.IsNullOrEmpty(u.FullName) ? u.FullName.Substring(0, 1) : "م";
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white small" style="width: 32px; height: 32px; background: var(--accent);">
                                            @initial
                                        </div>
                                        <span class="fw-bold text-dark">@u.FullName</span>
                                    </div>
                                </td>
                                <td class="text-muted small">@u.Email</td>
                                <td>
                                    <span class="badge @(u.Role == "Admin" ? "bg-danger" : "bg-primary")">@u.Role</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Demonstration Checklist -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="bi bi-check2-all me-2 text-success"></i>قائمة الميزات الجاهزة للشرح أمام الشركات</h5>
                <span class="badge bg-success">100% Tested</span>
            </div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex align-items-center gap-3 py-3 border-0 border-bottom">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong class="text-dark d-block">لوحة الكانبان اللحظية (SignalR Real-Time Kanban)</strong>
                        <small class="text-muted">سحب وإفلات البطاقات ونقلها بين الأعمدة مع تحديث فوري مباشر دون إعادة تحميل الصفحة.</small>
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center gap-3 py-3 border-0 border-bottom">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong class="text-dark d-block">نظام الدعوات الآمن (Project Invitations System)</strong>
                        <small class="text-muted">دعوة أعضاء بالبريد وتلقي إشعارات في جرس التنبيهات وقبولها من الويب أو الموبايل.</small>
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center gap-3 py-3 border-0 border-bottom">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong class="text-dark d-block">معمارية الطبقات النظيفة (Clean Architecture)</strong>
                        <small class="text-muted">فصل كامل للـ Domain والـ Application والـ Infrastructure والـ API مع Repository & Unit of Work.</small>
                    </div>
                </li>
                <li class="list-group-item d-flex align-items-center gap-3 py-3 border-0">
                    <i class="bi bi-check-circle-fill text-success fs-5"></i>
                    <div>
                        <strong class="text-dark d-block">تكامل الموبايل (Flutter Application & BLoC)</strong>
                        <small class="text-muted">تطبيق فلاتر كامل متصل بنفس قاعدة البيانات والباك إند مع تزامن تام ثنائي الاتجاه.</small>
                    </div>
                </li>
            </ul>
        </div>
    </div>
</div>
