@model List<Maham.Web.Services.WebUserDto>
@{
    ViewData["Title"] = "إدارة المستخدمين";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-people-fill text-danger me-2"></i>إدارة مستخدمي النظام</h3>
        <span class="text-muted">عرض جميع حسابات المستخدمين وتعديل الأدوار وصلاحيات الوصول</span>
    </div>
    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">إجمالي المستخدمين: @Model.Count</span>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle dt-table w-100">
                <thead>
                    <tr>
                        <th>الاسم الكامل</th>
                        <th>البريد الإلكتروني</th>
                        <th>الصلاحية (Role)</th>
                        <th>تاريخ التسجيل</th>
                        <th class="text-center">تعديل الصلاحية</th>
                        <th class="text-center">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td class="fw-bold">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="avatar-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center rounded-circle" style="width: 36px; height: 36px;">
                                        @(user.FullName?.Substring(0, 1) ?? "U")
                                    </div>
                                    <span>@user.FullName</span>
                                </div>
                            </td>
                            <td class="text-muted">@user.Email</td>
                            <td>
                                <span class="badge @(user.Role == "Admin" ? "bg-danger" : "bg-info text-dark")">@user.Role</span>
                            </td>
                            <td>@user.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="text-center">
                                <form action="/admin/users/@user.Id/role" method="post" class="d-inline-flex gap-1 align-items-center">
                                    <select name="role" class="form-select form-select-sm" style="width: 110px;">
                                        <option value="Member" selected="@(user.Role == "Member" ? "selected" : null)">Member</option>
                                        <option value="Admin" selected="@(user.Role == "Admin" ? "selected" : null)">Admin</option>
                                    </select>
                                    <button type="submit" class="btn btn-sm btn-outline-primary" title="حفظ الدور"><i class="bi bi-check-lg"></i></button>
                                </form>
                            </td>
                            <td class="text-center">
                                <form action="/admin/users/@user.Id/delete" method="post" onsubmit="return confirm('هل أنت تأكد من رغبتك في حذف هذا المستخدم من النظام؟');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="حذف الحساب"><i class="bi bi-trash"></i> حذف</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state py-5 text-center">
            <i class="bi bi-people display-3 text-muted"></i>
            <h5 class="fw-bold mt-3">لا يوجد مستخدمون مسجلون في النظام حالياً</h5>
        </div>
    }
</div>
